# Adafruit MacroPad RP2040 (operator). Stable names, seated-user access,
# and keep ModemManager away. Numbered >60-serial.rules (which sets
# ID_USB_INTERFACE_NUM - the SYMLINK lines need it) and <73 so
# TAG+="uaccess" is honored by 73-seat-late.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="8108", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="8108", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="operator-repl keymaker-repl"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="8108", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="operator-data keymaker-data"
