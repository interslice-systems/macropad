[Unit]
Description=Operator macropad daemon
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/python -m operatord
Environment=PYTHONPATH=%h/src/operator/shared:%h/src/operator/daemon
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
