[Unit]
Description=MacroPad desk companion daemon
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/python -m macropadd
Environment=PYTHONPATH=%h/src/macropad/shared:%h/src/macropad/daemon
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
